{
  "name": "breach-boulevard-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "npm run css && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "css": "tailwindcss -i src/styles.css -o public/styles/tailwind.css --minify",
    "db:check": "node scripts/check-database.mjs",
    "start": "node server/index.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "parse5": "7.2.1",
    "postcss": "8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "3.4.17",
    "vite": "5.4.21"
  },
  "engines": {
    "node": "22.x"
  }
}
