# Server configuration only. Copy to .env.server for local development.
# Do not prefix these with VITE_ or copy this file into public/dist.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_key
ADMIN_PASSWORD=
# Optional: use a Supabase publishable key for Auth requests. Never expose the server secret.
SUPABASE_PUBLISHABLE_KEY=
# Optional canonical website URL. Production defaults to the deployed domain.
SITE_URL=
# Legacy service-role JWTs are supported through SUPABASE_SERVICE_ROLE_KEY.
